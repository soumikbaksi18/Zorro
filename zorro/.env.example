# Copy to .env.local and fill in. All keys are server-side only: never expose them to the browser.

# NEAR Intents "Distribution Channel" key, for the 1Click API ("pay from another wallet", prices).
ONECLICK_API_KEY=

# NEAR Intents "Agent API" key, for Zorro wallets (creation, payee approvals, payments, deposits).
AGENT_API_KEY=

# 32 random bytes that encrypt Zorro's payment permissions at rest: `openssl rand -base64 32`.
# Keep it secret. Losing it means every wallet has to re-authorise Zorro.
ZORRO_ENCRYPTION_KEY=

# Ask Zorro voice + chat: Sarvam AI (speech-to-text, text-to-speech, Sarvam-105B chat). https://indus.sarvam.ai
SARVAM_API_KEY=

# Backup AI for Ask Zorro and the news brief (any OpenAI-compatible API).
DEEPSEEK_API_KEY=

# Zcash news page: a NewsAPI.org key (or a NewsData.io "pub_…" key; the format picks the service).
NEWS_API_KEY=

# Database. Locally: nothing to set (a SQLite file at ~/.zorro/zorro.db).
# On Vercel: a Turso database. See README → Deploy.
# DATABASE_URL=libsql://zorro-<you>.turso.io
# DATABASE_AUTH_TOKEN=

# Vercel Cron: protects /api/cron/tick (Autopay + payment processing). Any long random string:
# `openssl rand -hex 32`. Vercel sends it automatically to its own cron jobs.
# CRON_SECRET=

# Optional overrides
# ONECLICK_BASE_URL=https://1click.chaindefuser.com
# AGENT_API_BASE_URL=https://api.agentsonintents.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_TTS_SPEAKER=priya
# Payment worker tick in ms (default 5000)
# WORKER_TICK_MS=5000
