# Copy to .env.local and fill in. All keys are server-side only: never expose them to the browser.

# NEAR Intents "Distribution Channel" key, for the 1Click API (swaps, limit orders).
ONECLICK_API_KEY=

# NEAR Intents "Agent API" key, for the trading bots (agent wallets, grants, policies).
AGENT_API_KEY=

# AI strategy assistant (OpenAI-compatible API).
DEEPSEEK_API_KEY=

# Optional overrides
# ONECLICK_BASE_URL=https://1click.chaindefuser.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Development only: lets you set a fake ZEC price for the bot worker (demo). Never in production.
# ZORRO_DEMO_MODE=1
# Bot worker tick interval in ms (default 15000)
# BOT_TICK_MS=15000
